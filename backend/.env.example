# Groq AI API Key (get free key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use
GROQ_MODEL=llama-3.3-70b-versatile

# Zapier webhook URL (get from Zapier "Webhooks by Zapier" trigger)
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/your_id_here/

# CORS allowed origin (frontend URL)
FRONTEND_URL=http://localhost:3000

# Application environment
APP_ENV=development

# Shared secret used by the scheduled cron endpoint (POST /api/cron/daily-summary).
# Set this on Render AND in your GitHub Actions secrets so the scheduler can
# authenticate. Leave blank during local development.
CRON_SECRET=

# Optional GitHub webhook signing secret. When you create the webhook on
# GitHub, set the same value here so the backend can verify
# X-Hub-Signature-256 on every incoming request.
GITHUB_WEBHOOK_SECRET=
